.env

# The door's cached EZVIZ session and the phone bind it unlocks with. Both
# grant door access, so they are treated exactly like .env -- never
# committed. door.py writes them 0600 beside academy.db.
.ezviz_token.json
.ezviz_token.json.bind

academy.db
academy.db-wal
academy.db-shm
cards/
photos/
frontend/node_modules

# The academy's own workbooks: real names and mobile numbers, same as the
# database. seed.py reads them from here; copy them in by hand.
sheets/*.xlsx
sheets/*.xlsm
sheets/~$*

# One virtual environment per platform: they hold compiled binaries and
# cannot be shared between Windows, Linux and macOS.
.venv/
.venv-*/

# Bundled Python fetched by START.bat when the machine has none
runtime/

# PyInstaller output
build/
dist/

__pycache__/
*.pyc
.DS_Store
error.log

.idea