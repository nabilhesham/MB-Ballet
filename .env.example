# Copy to .env and fill in. Never commit .env — it holds secrets.
#
# Values are plain text: KEY=value. Surrounding quotes are allowed and are
# stripped, because the standalone unlock script documents its settings with
# them and python-dotenv removes them -- a file written that way used to mean
# two different things to the two programs, and the symptom was a door that
# would not open while the setting looked right here. Nothing else is
# interpreted: no \n escapes, and no inline # comments after a value.
#
# There is exactly ONE .env, and it is this folder's. A packaged build does
# not get its own: academy.spec reads this file at build time and compiles
# its values into the binary, which then never reads or writes a .env again.
# So changing a setting here and rebuilding is the whole story, and a build
# from a checkout with no ENTRY_SECRET is refused rather than shipped.

# Signs every member card. Running the app from source generates one on first
# run if this is missing; a build does not, it refuses. Losing it invalidates
# every card already printed, so keep a backup.
ENTRY_SECRET=

# Which database to run on. "sqlite" is the default and what the reception
# laptop should stay on: it is the only one that keeps working without
# internet. "mongo" is refused at startup if MB_MONGO_URI is not set — it
# never silently falls back, because that would mean a day of attendance
# written into a local file nobody looks at again.
MB_DB_BACKEND=sqlite

# Where the SQLite file lives, relative to the folder holding the app.
MB_SQLITE_PATH=academy.db

# Only read when MB_DB_BACKEND=mongo. Must be a replica set — Atlas is one,
# a standalone mongod is not, and transactions need it.
#
# THE srv:// FORM FAILS ON SOME NETWORKS. It needs a DNS SRV/TXT lookup, and
# a resolver that filters or drops those gives a DNS timeout that looks
# nothing like a configuration problem. This has already happened here. The
# direct form names the hosts instead and needs no SRV lookup:
#
#   MB_MONGO_URI=mongodb://h1:27017,h2:27017,h3:27017/?replicaSet=atlas-xxxx-shard-0&tls=true&authSource=admin
#
# To get the hosts when you only have the srv:// string, ask a resolver that
# works — for example over DNS-over-HTTPS, which needs no UDP port 53:
#
#   curl -s -H 'accept: application/dns-json' \
#     'https://cloudflare-dns.com/dns-query?name=_mongodb._tcp.<cluster>&type=SRV'
#   curl -s -H 'accept: application/dns-json' \
#     'https://cloudflare-dns.com/dns-query?name=<cluster>&type=TXT'
#
MB_MONGO_URI=
MB_MONGO_DB=mb_ballet

# Used by the test suite only, and deliberately a different name from
# MB_MONGO_URI so a misconfigured run cannot point the tests at production.
# Only databases named mbtest_* are ever created or dropped.
MB_TEST_MONGO_URI=

# drop_all() refuses a database whose name does not start with mbtest_
# unless this is set. On SQLite it unlinks a local file; on Atlas it can be
# a shared remote database, and seed.py --force runs from the same shell as
# everything else.
# MB_MONGO_ALLOW_DROP=1

# ---------------------------------------------------------------- the door
#
# The academy's EZVIZ DL05 smart lock. A valid check-in unlocks it, and the
# kiosk grows an "Open door" button; leave EZVIZ_LOCK_SERIAL empty and the
# app behaves exactly as it did before the lock existed -- no line, no
# button, nothing to explain. See door.py.
#
# These keep the EZVIZ_ names rather than being renamed to MB_, because the
# standalone unlock script this came from used them and a rename is a door
# that silently stops opening.
#
# The unlock goes out from this laptop to EZVIZ's cloud, which reaches the
# lock. So there is nothing to forward, no static IP, no inbound port, and
# the server keeps binding to 127.0.0.1. It does need the internet, which is
# the one thing in this app that does -- when the line is down the lock's own
# keypad, fingerprint and key all still work and reception opens it by hand.

# The lock's serial, on the sticker and in the EZVIZ app. Empty = no door.
EZVIZ_LOCK_SERIAL=

# Needed to sign in the first time, or after the saved session expires. The
# first sign-in may want an SMS code, which cannot be typed into a server --
# run the standalone unlock script once to do it, and the session it caches
# is what the app uses from then on.
#
# The address does one more thing: every unlock names it as the account the
# unlock came from (`userName`). So set it even on a machine that will never
# sign in for itself -- a build is what reception runs, and a build with no
# address here sends an empty one.
#
# They are treated differently by a build: the address is baked into the
# binary, the password never is. An address is a login name and opens
# nothing on its own; door.py needs both halves before it will attempt a
# sign-in at all.
EZVIZ_EMAIL=
EZVIZ_PASSWORD=

# Optional. The cached session and the phone bind live here; the default is
# `.ezviz_token.json` beside academy.db, which is deliberate -- a packaged
# build's own folder is wiped on exit, so a session cached there would be
# gone every time the app closes.
# EZVIZ_TOKEN_FILE=.ezviz_token.json

# Optional. The lock treats a remote unlock as coming from a bound phone.
# Left unset, the most recently used real phone on the account is picked and
# cached; name one here to pin it, or set EZVIZ_BIND_CODE to skip the lookup
# entirely (it is the phone's sign + userId, printed by the standalone
# script).
# EZVIZ_TERMINAL=iphone
# EZVIZ_BIND_CODE=

# Optional. The EZVIZ region endpoint; the default is Europe.
# EZVIZ_REGION=apiieu.ezvizlife.com
